{
  "name": "keystone-app",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "build": "keystone build",
    "start": "keystone start",
    "postinstall": "keystone postinstall",
    "dev": "keystone dev",
    "dev:preinstall": "cp .env.copy .env && npm install",
    "build:dry": "NODE_ENV=production keystone build",
    "generate": "keystone prisma migrate dev",
    "db:push": "keystone prisma db push",
    "db:seed": "ts-node --transpile-only ./seed/index.ts",
    "db:seed:all": "ts-node --transpile-only ./seed/index.ts -- --all",
    "db:seed:help": "ts-node --transpile-only ./seed/index.ts -- --help",
    "db:clear": "ts-node --transpile-only ./seed/clear.ts",
    "db:clear:all": "ts-node --transpile-only ./seed/clear.ts -- --all",
    "db:clear:help": "ts-node --transpile-only ./seed/clear.ts -- --help",
    "db:reset": "keystone prisma db push --force-reset",
    "db:reset:seed": "npm run db:reset && npm run db:seed",
    "db:fresh": "npm run db:reset && npm run db:seed:all",
    "db:help": "ts-node --transpile-only ./seed/help.ts",
    "schema:verify:dev": "NODE_ENV=production keystone build && keystone prisma migrate dev && keystone start",
    "schema:verify:prod": "keystone build && keystone prisma migrate deploy && keystone start"
  },
  "dependencies": {
    "@keystone-6/auth": "^8.1.0",
    "@keystone-6/core": "^6.5.1",
    "@keystone-6/fields-document": "^9.1.1",
    "@radix-ui/react-label": "2.0.2",
    "@radix-ui/react-separator": "1.0.3",
    "@radix-ui/react-slot": "1.0.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.2.3",
    "next": "13.5.6",
    "next-auth": "^4.24.13",
    "postcss": "^8.4.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": "24.1.0"
  },
  "overrides": {
    "next": "$next",
    "esbuild": "0.24.2"
  }
}
