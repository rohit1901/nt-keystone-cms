{
  "name": "nt-keystone-cms",
  "version": "1.0.4",
  "private": true,
  "scripts": {
    "build": "NODE_ENV=production keystone build",
    "start": "keystone start",
    "postinstall": "keystone postinstall",
    "dev": "keystone dev",
    "generate": "keystone build --no-ui && prisma migrate dev && prisma generate",
    "db:push": "keystone build --no-ui && prisma db push && prisma generate",
    "db:seed": "tsx ./seed/index.ts",
    "db:seed:help": "tsx ./seed/index.ts -- --help",
    "db:clear": "tsx ./seed/clear.ts",
    "db:clear:help": "tsx ./seed/clear.ts -- --help",
    "db:reset": "keystone build --no-ui && prisma db push --force-reset && prisma generate",
    "db:reset:seed": "pnpm db:reset && pnpm db:seed",
    "db:fresh": "pnpm db:reset && pnpm db:seed",
    "db:help": "tsx ./seed/index.ts -- --db-help",
    "schema:verify:dev": "pnpm build && prisma migrate dev && pnpm start",
    "schema:verify:prod": "pnpm build && prisma migrate deploy && pnpm start",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@keystone-6/core": "8.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "fast-uri": "3.1.6",
      "mysql2": "3.23.1",
      "qs": "6.16.0"
    }
  }
}
