{
  "name": "nt-keystone-cms",
  "version": "1.0.4",
  "private": true,
  "scripts": {
    "build": "keystone build",
    "start": "keystone start",
    "postinstall": "keystone postinstall && node node_modules/@prisma/engines/scripts/postinstall.js 2>/dev/null || true",
    "prisma:engines": "node node_modules/@prisma/engines/scripts/postinstall.js",
    "dev": "keystone dev",
    "dev:preinstall": "cp .env.copy .env && pnpm install",
    "build:dry": "NODE_ENV=production keystone build",
    "generate": "keystone prisma migrate dev",
    "db:push": "keystone prisma db push",
    "db:seed": "ts-node --transpile-only ./seed/index.ts",
    "db:seed:all": "ts-node --transpile-only ./seed/index.ts -- --all",
    "db:seed:help": "ts-node --transpile-only ./seed/index.ts -- --help",
    "db:clear": "ts-node --transpile-only ./seed/clear.ts",
    "db:clear:all": "ts-node --transpile-only ./seed/clear.ts -- --all",
    "db:clear:help": "ts-node --transpile-only ./seed/clear.ts -- --help",
    "db:reset": "keystone prisma db push --force-reset",
    "db:reset:seed": "pnpm db:reset && pnpm db:seed",
    "db:fresh": "pnpm db:reset && pnpm db:seed:all",
    "db:help": "ts-node --transpile-only ./seed/help.ts",
    "schema:verify:dev": "NODE_ENV=production keystone build && keystone prisma migrate dev && keystone start",
    "schema:verify:prod": "keystone build && keystone prisma migrate deploy && keystone start"
  },
  "dependencies": {
    "@keystone-6/auth": "^8.1.0",
    "@keystone-6/core": "^6.5.3",
    "@keystone-6/fields-document": "^9.1.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-label": "2.0.2",
    "@radix-ui/react-separator": "1.0.3",
    "@radix-ui/react-slot": "1.0.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.4.2",
    "next": "^14.2.35",
    "next-auth": "^4.24.15",
    "postcss": "^8.5.26",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "jsonresume-theme-stackoverflow": "^3.3.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12"
  },
  "overrides": {
    "esbuild": "0.24.2"
  }
}
