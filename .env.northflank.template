# Northflank Environment Variables Template
# Copy these variables to your Northflank service environment configuration
# Replace placeholder values with your actual values

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================
# Main database connection string
# Format: postgresql://username:password@host:port/database?schema=public
# Get this from your Northflank PostgreSQL database or use "Link to Database"
DATABASE_URL=postgresql://username:password@host:5432/keystone?schema=public

# Shadow database for Prisma migrations (Required for production)
# Create a separate database for shadow migrations or use a different schema
SHADOW_DATABASE_URL=postgresql://username:password@host:5432/keystone_shadow?schema=public

# =============================================================================
# NODE ENVIRONMENT (Required)
# =============================================================================
NODE_ENV=production
PORT=3000

# =============================================================================
# AUTHENTICATION - NEXTAUTH (Required)
# =============================================================================
# Your Northflank app URL or custom domain
# Format: https://your-app-name.northflank.app or https://yourdomain.com
NEXTAUTH_URL=https://your-app-name.northflank.app

# Generate a random secret: openssl rand -base64 32
# Keep this secret and never commit to version control
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# =============================================================================
# SESSION CONFIGURATION (Required)
# =============================================================================
# Generate a different random secret: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# Session max age in seconds (default: 30 days)
SESSION_MAX_AGE=2592000

# =============================================================================
# CORS CONFIGURATION (Required for API access)
# =============================================================================
# Comma-separated list of allowed origins
# Include both your main domain and any subdomains
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com,https://your-app-name.northflank.app

# =============================================================================
# AWS COGNITO (Optional - only if using AWS Cognito for authentication)
# =============================================================================
# Get these from your AWS Cognito User Pool
# COGNITO_CLIENT_ID=your_cognito_app_client_id
# COGNITO_CLIENT_SECRET=your_cognito_app_client_secret
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_YourPoolId

# =============================================================================
# ADDITIONAL CONFIGURATION (Optional)
# =============================================================================
# Node.js memory limit (if needed)
# NODE_OPTIONS=--max-old-space-size=1024

# Prisma logging (for debugging)
# PRISMA_LOG_LEVEL=info

# Enable query logging in development
# DATABASE_LOGGING=true

# =============================================================================
# NOTES FOR NORTHFLANK SETUP
# =============================================================================
# 1. Database Connection:
#    - Use Northflank's "Link to Database" feature to auto-populate DATABASE_URL
#    - Or manually create connection string from your database credentials
#    - Always use SSL in production: ?sslmode=require
#
# 2. Secrets Management:
#    - Mark sensitive values as "Secret" type in Northflank
#    - Never expose secrets in logs or version control
#
# 3. CORS Origins:
#    - Always include your Northflank app URL
#    - Add custom domains after DNS configuration
#    - Remove trailing slashes from URLs
#
# 4. Health Checks:
#    - Health check endpoint: /api/graphql
#    - Port: 3000
#    - Protocol: HTTP
#
# 5. Resources (Recommended starting values):
#    - CPU: 0.5 vCPU
#    - Memory: 1 GB
#    - Scale up based on usage
#
# 6. Build Configuration:
#    - Build context: . (root)
#    - Dockerfile path: Dockerfile
#    - No build arguments needed
#
# 7. Deployment:
#    - Migrations run automatically on container startup
#    - First deployment may take 2-3 minutes
#    - Monitor logs for "Keystone server listening on port 3000"
#
# =============================================================================
# GENERATING SECRETS
# =============================================================================
# On Linux/macOS:
#   openssl rand -base64 32
#
# On Windows (PowerShell):
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | % {[char]$_})
#
# Using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# =============================================================================
